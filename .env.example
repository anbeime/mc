# 麦当劳 MCP 配置模板
#
# 用法：把本文件复制为 .env，填入你的 Token，然后执行：
#     set -a && source .env && set +a
#
# .env 已被 .gitignore 排除，不会进入 Git 仓库。请勿把真实 Token 写进本文件提交。

# ── 必填 ────────────────────────────────────────────────────────────
# 从 https://open.mcd.cn/mcp 右上角「控制台」申请获得，以 mcdt 开头。
MCD_MCP_TOKEN=YOUR_MCP_TOKEN

# ── 可选 ────────────────────────────────────────────────────────────
# MCP 服务地址，默认官方地址，一般无需修改。
# MCD_MCP_ENDPOINT=https://mcp.mcd.cn
